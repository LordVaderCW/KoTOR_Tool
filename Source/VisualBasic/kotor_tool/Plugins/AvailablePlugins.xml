<?xml version="1.0" encoding="utf-8"?>
<PluginLibrary>
	<AvailablePlugin>
		<Id>ncsdecomp</Id>
		<Name>DeNCS</Name>
		<Version>1.0.2</Version>
		<Type>ExternalTool</Type>
		<Enabled>True</Enabled>
		<Directory>DeNCS</Directory>
		<GitHubRepo>https://github.com/OpenKotOR/DeNCS</GitHubRepo>
		<GitHubBranch>v1.0.2</GitHubBranch>
		<Website>https://github.com/OpenKotOR/DeNCS</Website>
		<DownloadUrl>https://github.com/OpenKotOR/DeNCS/releases/download/v1.0.2/DeNCS-v1.0.2-Windows.zip</DownloadUrl>
		<Description>Decompiles compiled KotOR NCS scripts into readable NSS source using NCSDecompCLI.</Description>
	</AvailablePlugin>


	<AvailablePlugin>
		<Id>mdlops</Id>
		<Name>MDLOps</Name>
		<Version>1.0.2</Version>
		<Type>ExternalTool</Type>
		<Enabled>True</Enabled>
		<Directory>MDLOps</Directory>
		<GitHubRepo>https://github.com/ndixUR/mdlops</GitHubRepo>
		<GitHubBranch>v1.0.2</GitHubBranch>
		<Website>https://github.com/ndixUR/mdlops</Website>
		<DownloadUrl>https://github.com/ndixUR/mdlops/releases/download/v1.0.2/mdlops-1.0.2.7z</DownloadUrl>
		<Description>Compiles and decompiles KotOR and TSL MDL/MDX models and supported walkmesh files using MDLOps.</Description>
	</AvailablePlugin>

	<AvailablePlugin>
		<Id>ghostrigger</Id>
		<Name>GhostRigger / KotOR 3D Model Converter</Name>
		<Version>source-genspark_ai_developer</Version>
		<Type>ExternalTool</Type>
		<SourceOnly>True</SourceOnly>
		<BuildRequired>True</BuildRequired>
		<SourceBuildProfile>GhostRigger</SourceBuildProfile>
		<BuildScriptName>build.bat</BuildScriptName>
		<BuiltExecutableName>GhostRigger-K1-K2.exe</BuiltExecutableName>
		<Description>Source-built KotOR 1 / TSL model pipeline for inspecting, editing, and exporting MDL/MDX model assets.</Description>
		<GitHubRepo>https://github.com/CrispyW0nton/Kotor-3D-Model-Converter</GitHubRepo>
		<GitHubBranch>genspark_ai_developer</GitHubBranch>
		<SourceZipUrl>https://github.com/CrispyW0nton/Kotor-3D-Model-Converter/archive/refs/heads/genspark_ai_developer.zip</SourceZipUrl>
		<DownloadUrl>https://github.com/CrispyW0nton/Kotor-3D-Model-Converter</DownloadUrl>
		<Website>https://github.com/CrispyW0nton/Kotor-3D-Model-Converter</Website>
		<Directory>GhostRigger</Directory>
		<Enabled>True</Enabled>
	</AvailablePlugin>

	
</PluginLibrary>