+-- Run using 3dsmaxbatch.exe, never in a working scene.
+global nx_testRoot = getFilenamePath (getSourceFileName())
+global nx_testLog = createFile (nx_testRoot + "foundation-results.txt")
+global g_ismax, g_fextn, g_startpath, gNX_scratchPath, g_maps_path
+global nx_parseInt, nx_parsePosition, nx_sanityFlags, ImportRollout
+global auroralight, ExAuroraAnimations, nwmax_handle, nx_importer
+global ImportNWNmdl, nx_reportError
+global gNX_prefsFile, nx_savePreference, nx_prefInt, nx_requireScript
+fn nx_check condition label =
+(
+    if condition != true do throw ("FAILED: " + label)
+    format "PASS: %\n" label to:nx_testLog
+    flush nx_testLog
+)
+try
+(
+    fileIn (nx_testRoot + "../nwmax.ms")
+    nx_check g_ismax "Max mode selected"
+    nx_check (g_fextn == ".max") "Max scene extension"
+    nx_check (doesFileExist (g_startpath + "nw_ie_inc/aurora_fn_export.ms")) "Absolute installation path"
+    nx_check ((nx_parseInt "nonsense" 10 5 30) == 10) "Malformed integer fallback"
+    nx_check ((nx_parseInt "" 10 5 30) == 10) "Empty integer fallback"
+    nx_check ((nx_parseInt "999" 10 5 30) == 10) "Out of range fallback"
+    nx_check ((nx_parsePosition "[2146,225]") == [2146,225]) "Legacy window position"
+    nx_check ((nx_parsePosition "garbage") == [0,100]) "Malformed position fallback"
+    nx_check ((nx_sanityFlags "1") == "11000111110111111111") "Short sanity flags fallback"
+    nx_check ((nx_sanityFlags "xxxxxxxxxxxxxxxxxxxx") == "11000111110111111111") "Invalid sanity flags fallback"
+    nx_check (g_maps_path.count == mapPaths.count()) "Host bitmap paths discovered"
+    local realPrefs = gNX_prefsFile
+    gNX_prefsFile = gNX_scratchPath + "test-prefs.ini"
+    nx_check (nx_savePreference "init" "animlistsize" 17) "Preferences writable"
+    nx_check ((nx_prefInt "animlistsize" 10 5 30) == 17) "Saved preference readback"
+    nx_savePreference "init" "animlistsize" "invalid"
+    nx_check ((nx_prefInt "animlistsize" 10 5 30) == 10) "Invalid saved preference falls back"
+    deleteFile gNX_prefsFile
+    gNX_prefsFile = realPrefs
+    local probe = createFile (gNX_scratchPath + "write-test.txt")
+    nx_check (probe != undefined) "Writable scratch directory"
+    close probe
+    deleteFile (gNX_scratchPath + "write-test.txt")
+    nx_check (ImportRollout.chk_resetctrl.checked == false) "Controller replacement is opt in"
+    nx_check (auroralight != undefined) "Light helper registered"
+    nx_check (ExAuroraAnimations undefined == undefined) "Export early return"
+    fileIn (nx_testRoot + "../nwmax.ms")
+    nx_check (nwmax_handle != undefined) "Second startup recreates floater"
+    nx_check (not IsSceneRedrawDisabled()) "Startup leaves redraw enabled"
+    local missingCaught = false
+    try (nx_requireScript (gNX_scratchPath + "missing-script.ms")) catch (missingCaught = true)
+    nx_check missingCaught "Required script failure propagates"
+    -- Exercise the UI import wrapper independently of the model parser.
+    -- Existing scene controllers must survive the optional legacy reset.
+    local originalImporter = ImportNWNmdl
+    local originalReporter = nx_reportError
+    global nx_testShouldFail = false
+    global nx_testReported = false
+    fn nx_reportError context detail notify:true = (nx_testReported = true; false)
+    fn ImportNWNmdl filename anims warnings loadGeom:true animLoadBase:undefined loadanimlist:undefined insertpoint:0 showprogress:false location:[0,0,0] =
+    (
+        if nx_testShouldFail do throw "Injected import failure"
+        dummy name:"NWmax_test_imported"
+        true
+    )
+    local existing = dummy name:"NWmax_test_existing"
+    existing.position.controller = bezier_position()
+    local originalController = existing.position.controller
+    ImportRollout.import_filename_edit.text = nx_testRoot + "max2021_foundation.ms"
+    ImportRollout.chk_resetctrl.checked = true
+    nx_check (nx_importer() == true) "Import wrapper succeeds"
+    nx_check (existing.position.controller == originalController) "Existing scene controllers preserved"
+    nx_check (classOf $NWmax_test_imported.position.controller == Linear_Position) "Opt in reset affects new nodes"
+    nx_testShouldFail = true
+    nx_check (nx_importer() == false) "Import failure reported"
+    nx_check nx_testReported "Import error reaches reporter"
+    nx_check (not IsSceneRedrawDisabled()) "Failure restores redraw"
+    disableSceneRedraw()
+    nx_importer()
+    nx_check (IsSceneRedrawDisabled()) "Failure preserves caller redraw suspension"
+    enableSceneRedraw()
+    ImportNWNmdl = originalImporter
+    nx_reportError = originalReporter
+    ImportRollout.chk_resetctrl.checked = false
+    ImportRollout.import_filename_edit.text = nx_testRoot + "foundation_triangle.mdl.ascii"
+    nx_check (nx_importer() == true) "Real ASCII model imports"
+    nx_check ($nx_foundation_mesh != undefined) "Imported mesh exists"
+    nx_check ($nx_foundation_mesh.numVerts == 3 and $nx_foundation_mesh.numFaces == 1) "Triangle topology preserved"
+    nx_check (classOf $nx_foundation_mesh.material == Standardmaterial) "Legacy Standard material created explicitly"
+    nx_check (existing.position.controller == originalController) "Real import preserves existing controllers"
+    format "ALL FOUNDATION CHECKS PASSED\n" to:nx_testLog
+) catch
+(
+    format "FAIL: %\n" (getCurrentException()) to:nx_testLog
+)
+close nx_testLog
